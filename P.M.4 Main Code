--==================================================

local function ClearPlayerButtons()
    for _, child in ipairs(PlayerScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

local function UpdatePlayerDetails()
    local player = State.SelectedPlayer

    if not player or player.Parent ~= Players then
        SelectedName.Text = "Select a player"

        for name, label in pairs(DetailLabels) do
            label.Text = name .. ": --"
        end

        return
    end

    local humanoid = GetHumanoid(player)
    local root = GetRoot(player)

    SelectedName.Text = player.DisplayName

    DetailLabels.Username.Text =
        "Username: @" .. player.Name

    DetailLabels["Display Name"].Text =
        "Display Name: " .. player.DisplayName

    DetailLabels["User ID"].Text =
        "User ID: " .. player.UserId

    DetailLabels["Account Age"].Text =
        "Account Age: " .. player.AccountAge .. " days"

    if humanoid then
        DetailLabels.Health.Text = string.format(
            "Health: %d / %d",
            math.floor(humanoid.Health),
            math.floor(humanoid.MaxHealth)
        )

        DetailLabels["Walk Speed"].Text =
            "Walk Speed: " .. humanoid.WalkSpeed

        DetailLabels["Character Status"].Text =
            "Character Status: " .. humanoid:GetState().Name
    else
        DetailLabels.Health.Text = "Health: No character"
        DetailLabels["Walk Speed"].Text = "Walk Speed: --"
        DetailLabels["Character Status"].Text = "Character Status: Unavailable"
    end

    if root then
        local position = root.Position

        DetailLabels.Position.Text = string.format(
            "Position: %.1f, %.1f, %.1f",
            position.X,
            position.Y,
            position.Z
        )
    else
        DetailLabels.Position.Text = "Position: --"
    end

    DetailLabels["Network Ping"].Text =
        "Network Ping: " .. GetPing(player) .. " ms"
end

local function SelectPlayer(player)
    State.SelectedPlayer = player
    UpdatePlayerDetails()
end

local function RefreshPlayerList()
    ClearPlayerButtons()

    local search = string.lower(SearchBox.Text)

    local sortedPlayers = Players:GetPlayers()

    table.sort(sortedPlayers, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)

    for _, player in ipairs(sortedPlayers) do
        local usernameMatch = string.find(
            string.lower(player.Name),
            search,
            1,
            true
        )

        local displayMatch = string.find(
            string.lower(player.DisplayName),
            search,
            1,
            true
        )

        if search == "" or usernameMatch or displayMatch then
            local playerButton = Button(
                PlayerScroll,
                player.DisplayName .. "  (@" .. player.Name .. ")",
                UDim2.new(1, -5, 0, 35)
            )

            playerButton.Name = player.Name

            playerButton.TextXAlignment = Enum.TextXAlignment.Left

            Padding(playerButton, 9)

            playerButton.MouseButton1Click:Connect(function()
                SelectPlayer(player)
            end)
        end
    end

    UpdatePlayerDetails()
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(
    RefreshPlayerList
)

