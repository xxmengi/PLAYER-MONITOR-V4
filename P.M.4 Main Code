--==================================================
-- RENDER LOOP
--==================================================

table.insert(
    State.Connections,
    RunService.RenderStepped:Connect(function(deltaTime)
        if not State.Running then
            return
        end

        UpdateFPS(deltaTime)
    end)
)

--==================================================
-- PERIODIC UPDATE LOOP
--==================================================

task.spawn(function()
    while State.Running and ScreenGui.Parent do
        UpdateDashboard()

        if State.CurrentPage == "Players" then
            UpdatePlayerDetails()
        end

        task.wait(Config.UpdateInterval)
    end
end)

--==================================================
-- KEYBOARD CONTROLS
--==================================================

table.insert(
    State.Connections,
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if input.KeyCode == Config.ToggleKey then
            State.Visible = not State.Visible

            Main.Visible = State.Visible
        end
    end)
)

--==================================================
-- CLEANUP
--==================================================

local function Cleanup()
    if not State.Running then
        return
    end

    State.Running = false

    for _, connection in ipairs(State.Connections) do
        if connection.Connected then
            connection:Disconnect()
        end
    end

    for _, connection in pairs(State.PlayerConnections) do
        if connection.Connected then
            connection:Disconnect()
        end
    end

    table.clear(State.Connections)
    table.clear(State.PlayerConnections)
end

table.insert(
    State.Connections,
    ScreenGui.Destroying:Connect(Cleanup)
)

--==================================================
-- INITIALIZATION
--==================================================

RefreshPlayerList()

UpdateDashboard()

Main.Visible = true

print("[PlayerMonitorV4] Successfully initialized.")
print("[PlayerMonitorV4] Toggle key: RightShift")
