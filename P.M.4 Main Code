--==================================================
-- PERFORMANCE TRACKING
--==================================================

local frameCount = 0
local elapsed = 0

local sessionStart = Workspace.DistributedGameTime

local function UpdateFPS(deltaTime)
    frameCount += 1
    elapsed += deltaTime

    if elapsed >= 1 then
        State.FPS = math.floor(frameCount / elapsed)

        frameCount = 0
        elapsed = 0
    end
end

--==================================================
-- LIVE DASHBOARD UPDATES
--==================================================

local function UpdateDashboard()
    local players = Players:GetPlayers()

    State.Ping = GetPing(LocalPlayer)
    State.Memory = GetMemory()

    PlayerCountValue.Text = #players

    FPSValue.Text = State.FPS

    PingValue.Text = State.Ping .. " ms"

    MemoryValue.Text = State.Memory .. " MB"

    ServerPlace.Text =
        "Place ID: " .. game.PlaceId

    ServerJob.Text =
        "Job ID: " .. (game.JobId ~= "" and game.JobId or "Studio session")

    ServerUptime.Text = string.format(
        "Session uptime: %d seconds",
        math.floor(Workspace.DistributedGameTime - sessionStart)
    )

    DiagnosticFPS.Text =
        "FPS: " .. State.FPS

    DiagnosticPing.Text =
        "Network Ping: " .. State.Ping .. " ms"

    DiagnosticMemory.Text =
        "Memory: " .. State.Memory .. " MB"

    DiagnosticPlayers.Text =
        "Connected Players: " .. #players

    PlaceInfo.Text =
        "Place: " .. game.PlaceId

    ServerTime.Text = string.format(
        "Server Runtime: %d seconds",
        math.floor(Workspace.DistributedGameTime)
    )

    UpdatePlayerDetails()
end

